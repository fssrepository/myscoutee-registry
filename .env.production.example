# Copy this file to a protected path outside the repository and pass it with:
# docker compose --env-file /path/to/registry-production.env \
#   -f compose.production.yaml up --build -d

# First-party image versioning follows the application stack.
MYSCOUTEE_VERSION=1.0.0
REGISTRY_PRODUCTION_IMAGE=myscoutee-registry:${MYSCOUTEE_VERSION}-prod

# Mandatory immutable signed namespace for this independently governed registry.
REGISTRY_SCOPE=example:region-a

# Public TLS endpoint. Use a DNS hostname present in the supplied certificate.
REGISTRY_PUBLIC_HOSTNAME=registry.example.invalid
REGISTRY_PUBLIC_BIND_ADDRESS=0.0.0.0
REGISTRY_HTTP_PORT=80
REGISTRY_HTTPS_PORT=443

# Operator-supplied files; the repository never generates production TLS keys.
REGISTRY_TLS_CERTIFICATE_PATH=/opt/myscoutee-registry/tls/fullchain.pem
REGISTRY_TLS_PRIVATE_KEY_PATH=/opt/myscoutee-registry/tls/privkey.pem

# Registry policy.
REGISTRY_GENERATE_SIGNING_KEY=true
REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY=true
REGISTRY_TIMESTAMP_SKEW=5m
REGISTRY_CHECKPOINT_INTERVAL=1m
REGISTRY_MAX_REQUEST_BODY_BYTES=65536
REGISTRY_VALUATION_MULTIPLIER_BASIS_POINTS=30000

# There is no public announcement writer or automatic update installer.
# Publication uses the local /registry publish-announcement CLI against this
# database/key volume after a consistent backup and operator review.

# Public-edge abuse and request bounds. Keep the edge body limit no larger
# than the backend limit unless both values are deliberately changed together.
REGISTRY_EDGE_MAX_BODY_SIZE=64k
REGISTRY_EDGE_REQUEST_RATE=10r/s
REGISTRY_EDGE_REQUEST_BURST=20
REGISTRY_EDGE_CONNECTION_LIMIT=20
