# Copy this file to install.env and restrict it before adding credentials:
#   cp install.env.example install.env
#   chmod 0600 install.env

REMOTE_HOST=
REMOTE_USER=
REMOTE_PORT=22

# Prefer a dedicated SSH key. Password authentication remains supported without
# placing the password in process arguments or the environment.
REMOTE_KEY_FILE=
REMOTE_PASSWORD=

# Defaults to REMOTE_PASSWORD when empty. Prefer a narrowly scoped sudo policy
# or passwordless sudo for the deployment account where operationally suitable.
REMOTE_SUDO_PASSWORD=

REMOTE_DEB_PATH=/tmp/myscoutee-registry.deb
REMOTE_HOST_KEY_CHECKING=accept-new
REMOTE_CONNECT_TIMEOUT_SECONDS=20
REMOTE_SSH_OPTIONS=

RUN_APT_UPDATE=false
QUALIFY_TIMEOUT_SECONDS=300
ALLOW_DOWNGRADE=false

# Installation never starts a fresh Registry by default. To provision and
# start a fresh deployment, copy deployment.env.example to the gitignored
# deployment.env, set all three absolute local input paths, and opt in.
START_SERVICE=false
DEPLOYMENT_ENV_FILE=
TLS_CERTIFICATE_FILE=
TLS_PRIVATE_KEY_FILE=

# apt package purge removes the managed configuration, TLS material, state,
# keys, and managed images. Set true only after verifying an independent
# recovery-unit backup.
CONFIRM_PURGE_WITH_VERIFIED_BACKUP=false

# Signed release verification. Pin the full SPKI fingerprint through an
# independent channel; a key downloaded beside the artifacts is not by itself
# a trust anchor.
RELEASE_MANIFEST_PATH=
RELEASE_PUBLIC_KEY_PATH=
RELEASE_PUBLIC_KEY_FINGERPRINT=

# Development-only escape hatch for a package built directly from this
# checkout. Keep false for every downloaded or published artifact.
ALLOW_UNSIGNED_LOCAL_PACKAGE=false

# Optional URL printed after installation. The installer never invokes
# the external verifier; run the printed command separately from this client.
VERIFY_DEPLOYMENT_URL=

# Comma-separated local[:remote] public-port mappings. A bare port is
# same-port. Local tunnel listeners always remain on loopback.
LOCAL_FORWARD_HOST=127.0.0.1
LOCAL_FORWARD_REMOTE_HOST=127.0.0.1
LOCAL_FORWARD_PORTS=18443:443,18080:80
