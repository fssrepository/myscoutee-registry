# Copy to the gitignored deployment.env and set the permanent Registry scope
# and public DNS hostname before the first start. Version and image references
# must match the Debian package being installed.
MYSCOUTEE_REGISTRY_VERSION=1.3.0
REGISTRY_PRODUCTION_IMAGE=myscoutee-registry:1.3.0-prod
REGISTRY_NGINX_PRODUCTION_IMAGE=myscoutee-registry-nginx:1.3.0-prod

REGISTRY_SCOPE=
REGISTRY_STATE_DIR_HOST=/var/lib/myscoutee-registry/data
REGISTRY_LISTEN_ADDR=:8080
REGISTRY_DATABASE_PATH=/data/registry.db
REGISTRY_SIGNING_KEY_PATH=/data/registry-signing-key.pem
REGISTRY_GENERATE_SIGNING_KEY=true
REGISTRY_GLOBAL_IDENTITY_VOPRF_KEYRING_PATH=/data/registry-global-identity-voprf-keyring.json
REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY=true
REGISTRY_DEMO_SEED=false
REGISTRY_TIMESTAMP_SKEW=5m
REGISTRY_CHECKPOINT_INTERVAL=1m
REGISTRY_MAX_REQUEST_BODY_BYTES=65536
REGISTRY_VALUATION_MULTIPLIER_BASIS_POINTS=30000
REGISTRY_SHUTDOWN_TIMEOUT=10s
REGISTRY_HEALTHCHECK_URL=http://127.0.0.1:8080/healthz

REGISTRY_PUBLIC_HOSTNAME=
REGISTRY_PUBLIC_BIND_ADDRESS=0.0.0.0
REGISTRY_HTTP_PORT=80
REGISTRY_HTTPS_PORT=443
REGISTRY_TLS_CERTIFICATE_PATH=/etc/myscoutee-registry/tls/fullchain.pem
REGISTRY_TLS_PRIVATE_KEY_PATH=/etc/myscoutee-registry/tls/privkey.pem
REGISTRY_NGINX_MAX_BODY_SIZE=64k
REGISTRY_NGINX_REQUEST_RATE=10r/s
REGISTRY_NGINX_REQUEST_BURST=20
REGISTRY_NGINX_CONNECTION_LIMIT=20
