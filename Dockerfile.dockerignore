# The root Dockerfile builds only the development Go registry. Production
# release inputs are owned by the isolated packaging build contexts.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**

# Dockerfile-specific ignore files replace the shared .dockerignore. Repeat
# the sensitive-file denies after the directory exceptions so they win.
**/*_test.go
**/.env*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.pem
**/*.key
**/*.p8
**/*private*key*
**/secrets
**/secrets/**
