#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
  printf 'myscoutee-registry-stack: %s\n' "$*" >&2
  exit 1
}

install_root="${MYSCOUTEE_REGISTRY_INSTALL_ROOT:-/opt/myscoutee-registry}"
config_file="${MYSCOUTEE_REGISTRY_CONFIG_FILE:-/etc/myscoutee-registry/registry.env}"
project_name="${MYSCOUTEE_REGISTRY_COMPOSE_PROJECT:-myscoutee-registry}"
docker_bin="${DOCKER_BIN:-docker}"
compose_file="$install_root/compose.yaml"
manifest_file="$install_root/IMAGE-MANIFEST.json"
version_file="$install_root/VERSION"

read_env_value() {
  local key="$1"
  local file="$2"
  local line value

  [[ -f "$file" ]] || return 1
  line="$(
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$file" |
      tail -n 1
  )"
  [[ -n "$line" ]] || return 1
  value="${line%$'\r'}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

require_env_value() {
  local key="$1"
  local value

  value="$(read_env_value "$key" "$config_file" || true)"
  [[ -n "$value" ]] || fail "$key is missing or empty in $config_file"
  printf '%s' "$value"
}

is_boolean() {
  case "${1,,}" in
    true|false)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

require_secure_file_mode() {
  local path="$1"
  local label="$2"
  local mode numeric_mode

  mode="$(stat -Lc '%a' "$path")" ||
    fail "cannot inspect $label permissions: $path"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] ||
    fail "$label has an unexpected permission mode: $mode"
  numeric_mode=$((8#$mode))
  (( (numeric_mode & 0077) == 0 )) ||
    fail "$label must not be group- or other-accessible: $path (mode $mode)"
}

validate_manifest() {
  local version expected_architecture

  [[ -f "$version_file" && ! -L "$version_file" ]] ||
    fail "installed version marker is missing or unsafe: $version_file"
  version="$(sed -n '1p' "$version_file")"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    fail "installed version marker is invalid: $version"

  expected_architecture="linux/amd64"
  [[ -f "$manifest_file" && ! -L "$manifest_file" ]] ||
    fail "installed image manifest is missing or unsafe: $manifest_file"
  jq -e \
    --arg version "$version" \
    --arg platform "$expected_architecture" '
      .schema_version == 1
      and .stack_version == $version
      and .platform == $platform
      and (.images | type == "array" and length == 2)
      and ([.images[].service] | sort == ["nginx", "registry"])
      and all(.images[];
        (.reference | type == "string" and length > 0)
        and (.image_id | test("^sha256:[0-9a-f]{64}$"))
        and (.archive_sha256 | test("^sha256:[0-9a-f]{64}$"))
        and (
          if .service == "registry"
          then .archive == "images/myscoutee-registry.tar"
          elif .service == "nginx"
          then .archive == "images/myscoutee-registry-edge.tar"
          else false
          end
        )
      )
    ' "$manifest_file" >/dev/null ||
    fail "installed image manifest failed its schema and release checks"
}

verify_image_archives() {
  local archive expected actual
  local -a rows=()

  validate_manifest
  mapfile -t rows < <(
    jq -r '.images[] | [.archive, .archive_sha256] | @tsv' "$manifest_file"
  )
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r archive expected <<< "$row"
    [[ -f "$install_root/$archive" && ! -L "$install_root/$archive" ]] ||
      fail "bundled image archive is missing or unsafe: $archive"
    expected="${expected#sha256:}"
    actual="$(sha256sum "$install_root/$archive" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] ||
      fail "bundled image archive checksum mismatch: $archive"
    tar -tf "$install_root/$archive" >/dev/null ||
      fail "bundled image archive is not a valid tar file: $archive"
  done
}

validate_tls_pair() {
  local certificate_path="$1"
  local private_key_path="$2"
  local certificate_public_key private_public_key

  [[ "$certificate_path" == /* ]] ||
    fail "REGISTRY_TLS_CERTIFICATE_PATH must be absolute"
  [[ "$private_key_path" == /* ]] ||
    fail "REGISTRY_TLS_PRIVATE_KEY_PATH must be absolute"
  [[ -f "$certificate_path" && -r "$certificate_path" ]] ||
    fail "TLS certificate is missing or unreadable: $certificate_path"
  [[ -f "$private_key_path" && -r "$private_key_path" ]] ||
    fail "TLS private key is missing or unreadable: $private_key_path"
  require_secure_file_mode "$private_key_path" "TLS private key"

  openssl x509 -in "$certificate_path" -noout -checkend 0 >/dev/null 2>&1 ||
    fail "TLS certificate is invalid or expired: $certificate_path"
  openssl pkey \
    -in "$private_key_path" \
    -passin pass: \
    -noout >/dev/null 2>&1 ||
    fail "TLS private key is invalid or passphrase-protected: $private_key_path"

  certificate_public_key="$(
    openssl x509 -in "$certificate_path" -pubkey -noout |
      openssl pkey -pubin -outform DER 2>/dev/null |
      sha256sum |
      awk '{print $1}'
  )" ||
    fail "cannot derive the certificate public key"
  private_public_key="$(
    openssl pkey -in "$private_key_path" -passin pass: -pubout -outform DER 2>/dev/null |
      sha256sum |
      awk '{print $1}'
  )" ||
    fail "cannot derive the private-key public key"
  [[ -n "$certificate_public_key" &&
    "$certificate_public_key" == "$private_public_key" ]] ||
    fail "TLS certificate and private key do not match"
}

validate_configuration() {
  local mode numeric_mode confirmation scope hostname
  local certificate_path private_key_path key_generation voprf_generation
  local packaged_version expected_registry_image expected_edge_image
  local configured_registry_image configured_edge_image

  [[ -f "$config_file" ]] ||
    fail "deployment configuration is missing: $config_file"
  mode="$(stat -Lc '%a' "$config_file")" ||
    fail "cannot inspect deployment configuration permissions"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] ||
    fail "deployment configuration has an unexpected mode: $mode"
  numeric_mode=$((8#$mode))
  (( (numeric_mode & 0077) == 0 )) ||
    fail "deployment configuration must be mode 0600 or stricter: $config_file"

  confirmation="$(require_env_value REGISTRY_OPERATOR_CONFIGURATION_CONFIRMED)"
  [[ "${confirmation,,}" == "true" ]] ||
    fail "operator configuration is not confirmed; review it before setting REGISTRY_OPERATOR_CONFIGURATION_CONFIRMED=true"

  scope="$(require_env_value REGISTRY_SCOPE)"
  [[ "$scope" != "example:region-a" && "$scope" != *[[:space:]]* ]] ||
    fail "REGISTRY_SCOPE is still a placeholder or contains whitespace"

  hostname="$(require_env_value REGISTRY_PUBLIC_HOSTNAME)"
  [[ "$hostname" != "registry.example.invalid" &&
    "$hostname" != *.invalid &&
    "$hostname" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ &&
    "$hostname" == *.* ]] ||
    fail "REGISTRY_PUBLIC_HOSTNAME must be a non-placeholder DNS hostname"

  require_env_value REGISTRY_PUBLIC_BIND_ADDRESS >/dev/null
  require_env_value REGISTRY_HTTP_PORT >/dev/null
  require_env_value REGISTRY_HTTPS_PORT >/dev/null

  key_generation="$(require_env_value REGISTRY_GENERATE_SIGNING_KEY)"
  voprf_generation="$(
    require_env_value REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY
  )"
  is_boolean "$key_generation" ||
    fail "REGISTRY_GENERATE_SIGNING_KEY must be explicitly true or false"
  is_boolean "$voprf_generation" ||
    fail "REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY must be explicitly true or false"

  certificate_path="$(require_env_value REGISTRY_TLS_CERTIFICATE_PATH)"
  private_key_path="$(require_env_value REGISTRY_TLS_PRIVATE_KEY_PATH)"
  validate_tls_pair "$certificate_path" "$private_key_path"

  packaged_version="$(sed -n '1p' "$version_file")"
  expected_registry_image="$(
    jq -r '.images[] | select(.service == "registry") | .reference' \
      "$manifest_file"
  )"
  expected_edge_image="$(
    jq -r '.images[] | select(.service == "nginx") | .reference' \
      "$manifest_file"
  )"
  configured_registry_image="$(require_env_value REGISTRY_PRODUCTION_IMAGE)"
  configured_edge_image="$(require_env_value REGISTRY_EDGE_IMAGE)"
  [[ "$(require_env_value MYSCOUTEE_VERSION)" == "$packaged_version" ]] ||
    fail "MYSCOUTEE_VERSION does not match the installed package"
  [[ "$configured_registry_image" == "$expected_registry_image" ]] ||
    fail "REGISTRY_PRODUCTION_IMAGE does not match the installed package manifest"
  [[ "$configured_edge_image" == "$expected_edge_image" ]] ||
    fail "REGISTRY_EDGE_IMAGE does not match the installed package manifest"
}

compose() {
  "$docker_bin" compose \
    --project-name "$project_name" \
    --env-file "$config_file" \
    -f "$compose_file" \
    "$@"
}

check() {
  command -v "$docker_bin" >/dev/null 2>&1 ||
    fail "Docker command is unavailable: $docker_bin"
  command -v jq >/dev/null 2>&1 || fail "jq is required"
  command -v openssl >/dev/null 2>&1 || fail "openssl is required"
  command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"
  command -v tar >/dev/null 2>&1 || fail "tar is required"
  [[ -f "$compose_file" && ! -L "$compose_file" ]] ||
    fail "installed Compose model is missing or unsafe: $compose_file"

  verify_image_archives
  validate_configuration
  compose config --quiet
  printf 'MyScoutee Registry package and operator configuration: PASS\n'
}

load_images() {
  local reference expected_id archive actual_id
  local -a rows=()

  verify_image_archives
  "$docker_bin" info >/dev/null 2>&1 ||
    fail "Docker daemon is not reachable"
  mapfile -t rows < <(
    jq -r \
      '.images[] | [.reference, .image_id, .archive] | @tsv' \
      "$manifest_file"
  )
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r reference expected_id archive <<< "$row"
    actual_id="$(
      "$docker_bin" image inspect --format '{{.Id}}' "$reference" 2>/dev/null ||
        true
    )"
    if [[ "$actual_id" != "$expected_id" ]]; then
      printf 'Loading bundled image: %s\n' "$reference"
      "$docker_bin" image load --input "$install_root/$archive" >/dev/null ||
        fail "cannot load bundled image: $reference"
      actual_id="$(
        "$docker_bin" image inspect --format '{{.Id}}' "$reference" 2>/dev/null ||
          true
      )"
    fi
    [[ "$actual_id" == "$expected_id" ]] ||
      fail "loaded image identity does not match the package manifest: $reference"
  done
}

usage() {
  cat <<'USAGE'
Usage: myscoutee-registry-stack COMMAND

Commands:
  check        Validate package assets, operator configuration, TLS, and Compose
  load-images  Verify and load the two bundled images without starting services
  up           Check, load locally, and start without builds or pulls
  stop         Stop the package Compose services without deleting state
  down         Remove package Compose containers/networks without deleting state
  status       Show package Compose service status
  logs         Follow package Compose logs
USAGE
}

command_name="${1:-}"
case "$command_name" in
  check)
    check
    ;;
  load-images)
    load_images
    ;;
  up)
    check
    load_images
    compose up --pull never -d
    ;;
  stop)
    compose stop
    ;;
  down)
    compose down --remove-orphans
    ;;
  status)
    compose ps
    ;;
  logs)
    compose logs --follow
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
