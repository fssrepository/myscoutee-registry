[Unit]
Description=MyScoutee Registry controlled production stack
Documentation=file:/usr/share/doc/myscoutee-registry/README.Debian
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/myscoutee-registry/registry.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/myscoutee-registry-stack up
ExecStop=/usr/sbin/myscoutee-registry-stack stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
