#!/usr/bin/env bash
set -Eeuo pipefail

case "${1:-}" in
  remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
  *)
    printf 'Unsupported myscoutee-registry postrm action: %s\n' \
      "${1:-missing}" >&2
    exit 1
    ;;
esac

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [[ "${1:-}" == "purge" ]]; then
  cat <<'MESSAGE'
MyScoutee Registry package files were purged. For safety, the operator-managed
/etc/myscoutee-registry configuration/TLS directory, Docker images, and
persistent registry data volume were not deleted. Remove those separately only
after verifying an independent recovery-unit backup.
MESSAGE
fi
