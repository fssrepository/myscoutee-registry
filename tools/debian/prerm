#!/usr/bin/env bash
set -Eeuo pipefail

case "${1:-}" in
  upgrade|failed-upgrade)
    # A package upgrade is controlled by the operator and does not stop or
    # restart a running registry.
    exit 0
    ;;
  remove|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop myscoutee-registry.service >/dev/null 2>&1 || true
      systemctl disable myscoutee-registry.service >/dev/null 2>&1 || true
    fi
    if [[ -x /usr/sbin/myscoutee-registry-stack ]]; then
      /usr/sbin/myscoutee-registry-stack down >/dev/null 2>&1 || true
    fi
    ;;
  *)
    printf 'Unsupported myscoutee-registry prerm action: %s\n' \
      "${1:-missing}" >&2
    exit 1
    ;;
esac
