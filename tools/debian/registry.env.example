# MyScoutee Registry Debian deployment configuration.
#
# The package never starts or enables the service automatically. Review every
# value below, install the TLS pair, decide the registry and VOPRF key policy,
# and change this gate to true only when the deployment is ready for its first
# explicit start.
REGISTRY_OPERATOR_CONFIGURATION_CONFIRMED=false

# These two local image references are installed by this exact package.
MYSCOUTEE_VERSION=1.0.0
REGISTRY_PRODUCTION_IMAGE=myscoutee-registry:1.0.0-prod
REGISTRY_EDGE_IMAGE=myscoutee-registry-edge:1.0.0-prod

# Mandatory immutable signed namespace for this independently governed registry.
REGISTRY_SCOPE=example:region-a

# Public TLS endpoint. The hostname must be present in the certificate.
REGISTRY_PUBLIC_HOSTNAME=registry.example.invalid
REGISTRY_PUBLIC_BIND_ADDRESS=0.0.0.0
REGISTRY_HTTP_PORT=80
REGISTRY_HTTPS_PORT=443

# Operator-supplied files. The package never creates or replaces them.
REGISTRY_TLS_CERTIFICATE_PATH=/etc/myscoutee-registry/tls/fullchain.pem
REGISTRY_TLS_PRIVATE_KEY_PATH=/etc/myscoutee-registry/tls/privkey.pem

# Explicit registry key policy. With true, keys are generated inside the
# persistent registry data volume on the first approved start. With false,
# provision and initialize the corresponding key material before ordinary
# startup, following the Operator Manual.
REGISTRY_GENERATE_SIGNING_KEY=true
REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY=true

# Registry policy.
REGISTRY_TIMESTAMP_SKEW=5m
REGISTRY_CHECKPOINT_INTERVAL=1m
REGISTRY_MAX_REQUEST_BODY_BYTES=65536
REGISTRY_VALUATION_MULTIPLIER_BASIS_POINTS=30000

# Public-edge abuse and request bounds.
REGISTRY_EDGE_MAX_BODY_SIZE=64k
REGISTRY_EDGE_REQUEST_RATE=10r/s
REGISTRY_EDGE_REQUEST_BURST=20
REGISTRY_EDGE_CONNECTION_LIMIT=20
