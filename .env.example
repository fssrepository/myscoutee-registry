# First-party image versioning follows the application stack.
MYSCOUTEE_VERSION=1.3.0
LOCAL_REGISTRY_IMAGE=myscoutee-registry:${MYSCOUTEE_VERSION}-dev

# Host port. The container always listens on 8080.
REGISTRY_BIND_ADDRESS=127.0.0.1
REGISTRY_PORT=8081

# compose.yaml and compose.dev.yaml run the isolated Explore/demo registry.
# For compose.prod.yaml, pass the production registry.env with --env-file;
# do not reuse this development environment file.
REGISTRY_SCOPE=demo:myscoutee

REGISTRY_GENERATE_SIGNING_KEY=true
REGISTRY_GENERATE_GLOBAL_IDENTITY_VOPRF_KEY=true
REGISTRY_DEMO_SEED=true
REGISTRY_TIMESTAMP_SKEW=5m
REGISTRY_CHECKPOINT_INTERVAL=1m
REGISTRY_VALUATION_MULTIPLIER_BASIS_POINTS=30000

# The demo baseline contains two signed community announcements. A real
# registry remains empty until its administrator uses publish-announcement.

# Used only with compose.provisioned-key.yaml.
# REGISTRY_PROVISIONED_KEY_PATH=/absolute/path/registry-signing-key.pem
