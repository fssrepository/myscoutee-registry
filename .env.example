# First-party image versioning follows the application stack.
MYSCOUTEE_VERSION=1.0.0
LOCAL_REGISTRY_IMAGE=myscoutee-registry:${MYSCOUTEE_VERSION}-dev

# Host port. The container always listens on 8080.
REGISTRY_BIND_ADDRESS=127.0.0.1
REGISTRY_PORT=8081

# Mandatory deployment-specific namespace. There are no built-in scope modes.
REGISTRY_SCOPE=example:region-a

REGISTRY_GENERATE_SIGNING_KEY=true
REGISTRY_TIMESTAMP_SKEW=5m
REGISTRY_CHECKPOINT_INTERVAL=1m

# Used only with compose.provisioned-key.yaml.
# REGISTRY_PROVISIONED_KEY_PATH=/absolute/path/registry-signing-key.pem
